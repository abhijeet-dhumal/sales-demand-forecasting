flowchart LR
    WB["Workbench<br/>RHOAI Kubeflow SDK"]
    TR["RHOAI TransformersTrainer<br/>CPU-first TrainJob"]
    FEAST["Feast FeatureService<br/>point-in-time retrieval"]
    RAY["KubeRay<br/>Ray offline plugin<br/>runtime compatibility pending"]
    PVC[("Shared PVC<br/>unique model run directory")]
    BT["Rolling-origin evaluation<br/>baselines + pooled tree"]
    HF["Hugging Face Trainer<br/>progress + periodic/JIT checkpoints"]
    MLP["Tabular MLP<br/>not selected or promoted"]
    MLFLOW["RHOAI-managed MLflow<br/>Workbench identity"]

    WB -->|submit + monitor| TR
    TR --> FEAST --> RAY --> FEAST --> TR
    TR --> BT --> HF --> MLP
    TR -->|model + JSON metrics| PVC
    TR -->|exit status| WB
    WB -->|after success: log artifacts + metrics| MLFLOW

    note1["The Workbench OAuth token is not passed to the Trainer pod."]
    WB -.-> note1
