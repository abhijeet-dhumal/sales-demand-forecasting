# Copy to .env and set credentials before deploying. .env is git-ignored.
DEMO_NAMESPACE=sales-demand-forecasting

# Shared project storage. RWX is needed by Workbench, Ray, training, and KServe.
SHARED_PVC_NAME=shared
SHARED_PVC_SIZE=100Gi
SHARED_STORAGE_CLASS=nfs-csi
POSTGRES_PVC_SIZE=10Gi

# PostgreSQL
POSTGRES_SERVICE=postgres
POSTGRES_DATA_PVC_NAME=postgres-data
POSTGRES_ADMIN_USERNAME=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=feast
POSTGRES_USERNAME=feast
POSTGRES_PASSWORD=replace-me
POSTGRES_ADMIN_PASSWORD=replace-me
POSTGRES_IMAGE=registry.redhat.io/rhel9/postgresql-15@sha256:04dc558560697443edac184d16684147eba4d6bb7a6dd646928ad433def33c95
POSTGRES_HOST=${POSTGRES_SERVICE}.${DEMO_NAMESPACE}.svc.cluster.local
POSTGRES_URL=postgresql://${POSTGRES_USERNAME}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DATABASE}
POSTGRES_PY_URL=postgresql+psycopg2://${POSTGRES_USERNAME}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DATABASE}
POSTGRES_CPU_REQUEST=250m
POSTGRES_MEMORY_REQUEST=512Mi
POSTGRES_CPU_LIMIT=1
POSTGRES_MEMORY_LIMIT=2Gi
POSTGRES_REPLICAS=1
POSTGRES_SCHEMA=public

# Local MinIO object store. Its own data uses an RWO block volume; shared demo
# files are copied to SHARED_PVC_NAME for Workbench, Ray, and Trainer access.
MINIO_IMAGE=docker.io/sourcemation/minio@sha256:4ba3029e0c4708a9c8ab06d51dc7b86d38304ab3e64bee10ededf6a7fc30e649
MINIO_SYNC_IMAGE=public.ecr.aws/aws-cli/aws-cli@sha256:cd2b1ed9b2181b2b8341f6584ec019b117cc13d3ec142a244d8908e1bb8ea487
MINIO_DATA_PVC_NAME=minio-data
MINIO_PVC_SIZE=20Gi
MINIO_STORAGE_CLASS=ibmc-vpc-block-10iops-tier
MINIO_FS_GROUP=1001650000
MINIO_SERVICE=minio
MINIO_ROOT_SECRET_NAME=minio-root-credentials
MINIO_CONSOLE_HOST=minio-sales-demand-forecasting.${CLUSTER_DOMAIN}
MINIO_CONSOLE_URL=https://${MINIO_CONSOLE_HOST}
MINIO_BUCKET=walmart-sales
MINIO_OBJECT_KEY=raw/walmart-sales-forecast.zip
MINIO_MANIFEST_OBJECT_KEY=raw/walmart-sales-forecast.zip.manifest.json

# Optional one-time Kaggle dataset import Job. Kaggle token is optional for
# public data; add the referenced Secret only if Kaggle requires authentication.
KAGGLE_DATASET_HANDLE=aslanahmedov/walmart-sales-forecast
KAGGLE_API_TOKEN_SECRET_NAME=kaggle-api-token
KAGGLE_IMPORT_IMAGE=docker.io/library/python@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
KAGGLEHUB_VERSION=1.0.2
BOTO3_VERSION=1.43.114

# RHOAI MLflow
CLUSTER_DOMAIN=apps.oai-kft-ibm.ibm.rh-ods.com
MLFLOW_TRACKING_URI=https://${MLFLOW_ROUTE_NAME}.${CLUSTER_DOMAIN}/mlflow
MLFLOW_WORKSPACE=${DEMO_NAMESPACE}
MLFLOW_EXPERIMENT_NAME=sales-forecasting
MLFLOW_VERSION=3.15.1
MLFLOW_INSECURE_TLS=false
MLFLOW_ROUTE_NAME=rh-ai
FEAST_PROJECT=sales_forecasting
FEAST_REGISTRY_CACHE_TTL_SECONDS=60

# Feast and Ray. 0.67.0 is the demo client candidate and still needs a
# client/server compatibility smoke check on the target cluster. The server
# pin is used only by the current legacy Deployment; RHOAI's operator-managed
# server version must be recorded separately when that path is adopted.
FEAST_CLIENT_VERSION=0.67.0
FEAST_SERVER_VERSION=0.67.0
FEAST_IMAGE=${RAY_IMAGE}
PSYCOPG2_BINARY_VERSION=2.9.13
PROTOBUF_VERSION=6.33.5
GRPCIO_VERSION=1.76.0
GRPCIO_HEALTH_CHECKING_VERSION=1.76.0
GRPCIO_REFLECTION_VERSION=1.76.0
GRPCIO_TOOLS_VERSION=1.76.0
UVICORN_VERSION=0.53.0
FEAST_SERVER_SERVICE=feast-server
FEAST_SERVER_PORT=6566
FEAST_SERVER_URL=http://${FEAST_SERVER_SERVICE}.${DEMO_NAMESPACE}.svc.cluster.local:${FEAST_SERVER_PORT}
FEAST_REQUEST_TIMEOUT_SECONDS=10
FEAST_UI_SERVICE=feast-ui
FEAST_UI_PORT=8888
FEAST_SERVER_CPU_REQUEST=250m
FEAST_SERVER_MEMORY_REQUEST=512Mi
FEAST_SERVER_CPU_LIMIT=1
FEAST_SERVER_MEMORY_LIMIT=2Gi
FEAST_CONFIGMAP_NAME=feast-config
FEAST_SERVICE_ACCOUNT=feast-sa
FEAST_OPERATOR_SERVICE_ACCOUNT=feast-sales-forecasting
WORKBENCH_SERVICE_ACCOUNT=demo-notebook
WORKBENCH_TRAINING_RUNTIME=torch-distributed-cpu
FEAST_UI_CPU_REQUEST=100m
FEAST_UI_MEMORY_REQUEST=256Mi
FEAST_UI_CPU_LIMIT=500m
FEAST_UI_MEMORY_LIMIT=1Gi
FEAST_SERVER_REPLICAS=1
FEAST_DB_SCHEMA=${POSTGRES_SCHEMA}
FEAST_UI_REPLICAS=1
FEAST_ENTITY_KEY_SERIALIZATION_VERSION=3
FEAST_READINESS_INITIAL_DELAY_SECONDS=30
FEAST_READINESS_PERIOD_SECONDS=10
FEAST_LIVENESS_INITIAL_DELAY_SECONDS=60
FEAST_LIVENESS_PERIOD_SECONDS=30
RAY_CLUSTER_NAME=feast-ray
RAY_VERSION=2.58.0
RAY_IMAGE=quay.io/abdhumal/sales-demand-forecasting-ray@sha256:d9e631090a28159e94579f2c5494bd91450abf6a082ce1358f9e4730ab2fde0a
CODEFLARE_SDK_VERSION=0.40.1
RAY_HEAD_CPUS=4
RAY_WORKER_REPLICAS=1
RAY_WORKER_MIN_REPLICAS=1
RAY_WORKER_MAX_REPLICAS=2
RAY_WORKER_CPUS=4
RAY_HEAD_CPU_REQUEST=4
RAY_HEAD_CPU_LIMIT=8
RAY_WORKER_CPU_LIMIT=8
RAY_HEAD_MEMORY_REQUEST=16Gi
RAY_HEAD_MEMORY_LIMIT=24Gi
RAY_WORKER_MEMORY_REQUEST=16Gi
RAY_WORKER_MEMORY_LIMIT=24Gi
RAY_OBJECT_STORE_MEMORY=4000000000
RAY_CLIENT_PORT=10001
RAY_DASHBOARD_PORT=8265
RAY_GCS_PORT=6379
RAY_STORAGE_PATH=/shared/data/ray_storage
RAY_DASHBOARD_SERVICE_TYPE=ClusterIP
RAY_SHARED_MEMORY_LIMIT=8Gi
DATAPREP_CPU_REQUEST=2
DATAPREP_MEMORY_REQUEST=4Gi
DATAPREP_CPU_LIMIT=4
DATAPREP_MEMORY_LIMIT=8Gi

# Optional synthetic-fixture job settings; notebooks 01-03 use the real Kaggle data instead.
DATAPREP_JOB_NAME=feast-dataprep
DATAPREP_JOB_BACKOFF_LIMIT=2
DATAPREP_JOB_TTL_SECONDS=3600
DATAPREP_COMPONENT=feature-engineering
DATA_START_DATE=2022-01-01
NUM_WEEKS=104
NUM_STORES=45
NUM_DEPARTMENTS=14
RANDOM_SEED=42
DATA_HOLIDAY_WEEKS=6,27,36,47,51
DATA_SEASONAL_AMPLITUDE=0.3
DATA_SEASONAL_PERIOD_WEEKS=52
DATA_SALES_BASE=50000
DATA_SALES_PER_STORE=5000
DATA_SALES_DEPT_BASE=0.5
DATA_SALES_PER_DEPT=0.2
DATA_HOLIDAY_SALES_MULTIPLIER=1.5
DATA_SALES_NOISE_STD=2000
DATA_TEMPERATURE_BASE=60
DATA_TEMPERATURE_AMPLITUDE=20
DATA_TEMPERATURE_NOISE_STD=5
DATA_FUEL_PRICE_BASE=3
DATA_FUEL_PRICE_VARIATION=0.5
DATA_CPI_BASE=220
DATA_CPI_WEEKLY_CHANGE=0.1
DATA_UNEMPLOYMENT_BASE=5
DATA_UNEMPLOYMENT_NOISE_STD=0.5
DATA_STORE_TYPES=A,B,C
DATA_STORE_SIZE_BASE=100000
DATA_STORE_SIZE_STEP=10000
DATA_STORES_PER_REGION=15
NUM_EPOCHS=50
USE_RAY=true
MODEL_HIDDEN_DIMS=512,256,128,64
MODEL_DROPOUT=0.3
TRAINING_BATCH_SIZE=64
TRAINING_LEARNING_RATE=0.0005
TRAINING_RUNTIME=torch-distributed-cpu
TRAINJOB_NAME=sales-forecasting-mlflow
TRAINING_RUN_NAME=sales-forecast
TRAINING_NUM_NODES=1
TRAINING_CPU_REQUEST=4
TRAINING_CPU_LIMIT=8
TRAINING_MEMORY_REQUEST=8Gi
TRAINING_MEMORY_LIMIT=16Gi
RDZV_TIMEOUT_SECONDS=3600
NCCL_TIMEOUT_SECONDS=3600
NCCL_DEBUG_LEVEL=WARN
NCCL_IB_DISABLE=1
NCCL_BLOCKING_WAIT=1
NCCL_ASYNC_ERROR_HANDLING=1
TRAINING_WEIGHT_DECAY=0.001
TRAINING_VALIDATION_FRACTION=0.2
# Rolling-origin candidate comparison; week numbers are 1-based positions in the full fixture.
# Week positions are relative to the latest BACKTEST_HOLDOUT_END_WEEK targets.
BACKTEST_VALIDATION_START_WEEK=89
BACKTEST_VALIDATION_END_WEEK=96
BACKTEST_HOLDOUT_START_WEEK=97
BACKTEST_HOLDOUT_END_WEEK=104
BACKTEST_MAX_ITER=40
BACKTEST_MIN_WAPE_IMPROVEMENT=0.02
BACKTEST_MAX_ABS_WEIGHTED_BIAS=0.05
TRAINING_NUM_WORKERS=2
TRAINING_MAPE_MIN_TARGET=1000
TRAINING_LR_SCHEDULER_FACTOR=0.5
TRAINING_LR_SCHEDULER_PATIENCE=3
TRAINING_RUN_PREFIX=train
TRAINING_CHECKPOINT_LIMIT=2
TRAINING_LOGGING_STEPS=100
TRAINER_PROGRESS_POLL_SECONDS=10
# Optional: set to a namespace LocalQueue name when Kueue is configured.
TRAINING_KUEUE_QUEUE=default
MODEL_REGISTRY_NAME=sales-forecasting-mlp
MODEL_REGISTRY_AUTHOR=kubeflow-training
MODEL_REGISTRY_PORT=8080
MODEL_REGISTRY_SECURE=false
# The RHOAI ClusterTrainingRuntime supplies its supported Transformers/Accelerate stack.
TRAINING_PIP_INDEX_URLS=https://pypi.org/simple
DATA_NOTEBOOK_PACKAGES=feast[postgres]==${FEAST_CLIENT_VERSION},pandas==2.3.3,pyarrow==25.0.1,psycopg2-binary==2.9.13
INFERENCE_NOTEBOOK_PACKAGES=kserve==0.21.0,pandas==2.3.3,tqdm==4.67.1,kubernetes==37.0.1,requests==2.32.4
PREDICTOR_PACKAGES=kserve==0.21.0|joblib==1.5.2|scikit-learn==1.9.0|requests==2.32.4
TRAINING_PACKAGES=feast[ray,postgres]==${FEAST_CLIENT_VERSION}|ray==${RAY_VERSION}|codeflare-sdk==${CODEFLARE_SDK_VERSION}|psycopg2-binary==${PSYCOPG2_BINARY_VERSION}|scikit-learn==1.9.0|pandas==2.3.3|pyarrow==25.0.1|joblib==1.5.2
MODEL_REGISTRY_URI=sales-model-registry.${DEMO_NAMESPACE}.svc.cluster.local:8080

# Shared paths
POD_SHARED_ROOT=/shared
WORKBENCH_SHARED_ROOT=/opt/app-root/src/shared
WALMART_DATA_DIR=${WORKBENCH_SHARED_ROOT}/walmart-competition-data
WORKBENCH_DATA_DIR=${WORKBENCH_SHARED_ROOT}/data
WORKBENCH_FEATURE_REPO_DIR=${WORKBENCH_SHARED_ROOT}/feature_repo
DATA_DIR=/shared/data
FEATURE_REPO_DIR=/shared/feature_repo
MODEL_DIR=/shared/models
PREDICTIONS_DIR=/shared/predictions

# KServe inference
MODEL_NAME=sales-forecast
INFERENCE_LABEL_APP=sales-forecasting
EXTERNAL_INFERENCE_SERVICE_NAME=sales-forecast-external
SERVE_CONFIGMAP_NAME=sales-forecast-serve
PREDICTOR_IMAGE=${RAY_IMAGE}
PREDICTOR_SERVICE_PORT=8080
PREDICTOR_MIN_REPLICAS=1
PREDICTOR_MAX_REPLICAS=3
PREDICTOR_CPU_REQUEST=500m
PREDICTOR_MEMORY_REQUEST=1Gi
PREDICTOR_CPU_LIMIT=2
PREDICTOR_MEMORY_LIMIT=4Gi
INFERENCE_READY_TIMEOUT_SECONDS=300
INFERENCE_REQUEST_TIMEOUT_SECONDS=30
INFERENCE_HEALTH_TIMEOUT_SECONDS=5
PREDICTOR_READINESS_INITIAL_DELAY_SECONDS=60
PREDICTOR_READINESS_PERIOD_SECONDS=10
TRAINJOB_WAIT_TIMEOUT_SECONDS=3600
